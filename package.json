{
  "name": "@realmikekelly/pi-mcp-events",
  "version": "0.1.0",
  "description": "Native MCP Events streams for Pi, with idle wakeups over local stdio",
  "type": "module",
  "license": "MIT",
  "author": "Mike Kelly",
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "patches",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "zod": "^4.6.5",
    "typebox": "^1.3.27"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=1.0.3"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.3",
    "@modelcontextprotocol/server": "^2.3.0",
    "@realmikekelly/figma-listen": "1.3.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "@realmikekelly/pi-mcp-adapter": "5.0.1"
  },
  "keywords": [
    "pi-package",
    "mcp",
    "events",
    "figma"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikekelly/pi-mcp-events.git"
  },
  "homepage": "https://github.com/mikekelly/pi-mcp-events#readme",
  "bugs": {
    "url": "https://github.com/mikekelly/pi-mcp-events/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
